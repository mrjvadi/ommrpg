; Engine configuration file.
; Godot 4.4 project for the OMMRPG client (Telegram Mini App / web first).

config_version=5

[application]

config/name="OMMRPG"
config/description="Seed-generated pixel open world, played full screen inside Telegram."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Cfg="*res://autoload/config.gd"
Telegram="*res://autoload/telegram.gd"
Api="*res://autoload/api.gd"
Realtime="*res://autoload/realtime.gd"
Sprites="*res://autoload/sprites.gd"
Game="*res://autoload/game_state.gd"
HudLayout="*res://autoload/hud_layout.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/Vazirmatn-Regular.ttf"
theme/default_font_antialiasing=1
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.0627451, 0.0627451, 0.0941176, 1)

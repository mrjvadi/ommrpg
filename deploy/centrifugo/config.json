{
  "log": {
    "level": "info"
  },
  "http_server": {
    "port": "8000"
  },
  "client": {
    "token": {
      "hmac_secret_key": "dev-centrifugo-token-secret"
    },
    "allowed_origins": [
      "*"
    ]
  },
  "http_api": {
    "key": "dev-api-key"
  },
  "channel": {
    "namespaces": [
      {
        "name": "area",
        "allow_subscribe_for_client": true
      },
      {
        "name": "dungeon",
        "allow_subscribe_for_client": true
      },
      {
        "name": "personal"
      },
      {
        "name": "news",
        "history_size": 20,
        "history_ttl": "24h",
        "allow_history_for_subscriber": true
      },
      {
        "name": "admin"
      }
    ]
  },
  "rpc": {
    "without_namespace": {
      "proxy_enabled": true,
      "proxy_name": "default"
    },
    "proxy": {
      "endpoint": "http://gateway:8080/centrifugo/rpc",
      "timeout": "3s",
      "http": {
        "static_headers": {
          "X-Proxy-Secret": "dev-proxy-secret"
        }
      }
    }
  }
}

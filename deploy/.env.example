# Copy to .env and change every secret before deploying.
TELEGRAM_BOT_TOKEN=
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
GAME_SECRET=change-me-long-random
CENTRIFUGO_TOKEN_SECRET=change-me-long-random
CENTRIFUGO_API_KEY=change-me-long-random
CENTRIFUGO_PROXY_SECRET=change-me-long-random
# 0 = pick a random world seed on first start; set a number to pin the world
WORLD_SEED=0
WORLD_SIZE_CHUNKS=64
# Allow /api/v1/auth/dev logins (for local development only)
DEV_LOGIN=false

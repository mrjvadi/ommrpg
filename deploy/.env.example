# Copy to .env and change every secret before deploying.
TELEGRAM_BOT_TOKEN=
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
GAME_SECRET=change-me-long-random
CENTRIFUGO_TOKEN_SECRET=change-me-long-random
CENTRIFUGO_API_KEY=change-me-long-random
CENTRIFUGO_PROXY_SECRET=change-me-long-random
# 0 = pick a random world seed on first start; set a number to pin the world
WORLD_SEED=0
WORLD_SIZE_CHUNKS=64
# Allow /api/v1/auth/dev logins (for local development only)
DEV_LOGIN=false
# OMM Chain block signing seed (keep secret, never rotate after launch)
CHAIN_SIGNING_KEY=change-me-long-random
# TON: mock for development; mainnet or testnet with a funded hot wallet.
# The seed is the 24-word mnemonic of the game wallet that receives deposits
# and sends withdrawals. Keep only an operating float in it.
TON_MODE=mock
TON_WALLET_SEED=
TON_WALLET_VERSION=v4r2
# Admin panel at /admin/. The first start creates this owner; if the
# password is empty a random one is printed once in the admin service log.
ADMIN_SECRET=change-me-long-random
ADMIN_BOOTSTRAP_USER=owner
ADMIN_BOOTSTRAP_PASSWORD=
